---
import Section from "../Section.astro";
import SectionHeading from "../SectionHeading.astro";

interface FeatureItem {
	title: string;
	description?: string;
	meta?: string;
}

interface Props {
	value: {
		label?: string;
		heading?: string;
		intro?: string;
		items?: FeatureItem[];
	};
}

const { value } = Astro.props;
const items = Array.isArray(value.items) ? value.items : [];
---

<Section>
	<SectionHeading label={value.label} title={value.heading}>
		{
			value.intro ? (
				<p class="mt-3 max-w-2xl text-base leading-relaxed text-muted-foreground">{value.intro}</p>
			) : null
		}
	</SectionHeading>

	{
		items.length > 0 ? (
			<div class="mt-8 grid gap-px overflow-hidden rounded-lg border border-border bg-border sm:grid-cols-2 lg:grid-cols-3">
				{items.map((item, index) => (
					<article class="flex flex-col bg-background p-6">
						<span class="font-mono text-[11px] uppercase tracking-wider text-foreground-lighter">
							{String(index + 1).padStart(2, "0")}
						</span>
						<h3 class="mt-4 text-base font-medium tracking-tight">{item.title}</h3>
						{item.description ? (
							<p class="mt-2 flex-1 text-sm leading-relaxed text-muted-foreground">
								{item.description}
							</p>
						) : null}
						{item.meta ? (
							<p class="mt-5 font-mono text-[11px] uppercase tracking-wider text-primary">
								{item.meta}
							</p>
						) : null}
					</article>
				))}
			</div>
		) : null
	}
</Section>
