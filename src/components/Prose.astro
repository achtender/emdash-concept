---
import type { PortableTextBlock } from "emdash";
import { PortableText } from "emdash/ui";
import ProseBlock from "./ProseBlock.astro";

interface Props {
	value?: PortableTextBlock[] | null;
	class?: string;
}

const { value, class: className } = Astro.props;
---

<div class:list={["prose", className]}>
	<PortableText value={value} components={{ block: ProseBlock }} />
</div>
