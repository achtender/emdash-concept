---
import {
	getEmDashCollection,
	getEmDashEntry,
	getSeoMeta,
	getSiteSettings,
	decodeSlug,
} from "emdash";
import Base from "../../layouts/Base.astro";
import Container from "../../components/Container.astro";
import Section from "../../components/Section.astro";
import Badge from "../../components/Badge.astro";
import Byline from "../../components/Byline.astro";
import Prose from "../../components/Prose.astro";
import Toc from "../../components/Toc.astro";
import { formatDate, getHeadings } from "../../utils/format";
import { resolveStarterSiteIdentity } from "../../utils/site-identity";

const slug = decodeSlug(Astro.params.slug);
if (!slug) return Astro.rewrite("/404");

const { entry: chapter, cacheHint } = await getEmDashEntry("handbook", slug);
if (!chapter) return Astro.rewrite("/404");
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const { entries: chapters, cacheHint: listHint } = await getEmDashCollection("handbook", {
	orderBy: { order: "asc" },
	limit: 100,
});
if (Astro.cache?.enabled) Astro.cache.set(listHint);

const SECTION_ORDER = ["Foundations", "Craft", "Process", "Standards"];
const ordered = [...chapters].sort((a, b) => {
	const sectionDelta =
		SECTION_ORDER.indexOf(a.data.section) - SECTION_ORDER.indexOf(b.data.section);
	if (sectionDelta !== 0) return sectionDelta;
	return (a.data.order ?? 0) - (b.data.order ?? 0);
});

const currentIndex = ordered.findIndex((entry) => entry.id === chapter.id);
const previous = currentIndex > 0 ? ordered[currentIndex - 1] : null;
const next = currentIndex >= 0 && currentIndex < ordered.length - 1 ? ordered[currentIndex + 1] : null;
const siblings = ordered.filter(
	(entry) => entry.data.section === chapter.data.section && entry.id !== chapter.id,
);

const { siteTitle } = resolveStarterSiteIdentity(await getSiteSettings());
const seo = getSeoMeta(chapter, {
	siteTitle,
	siteUrl: Astro.url.origin,
	path: Astro.url.pathname.replace(/\/$/, ""),
});

const headings = getHeadings(chapter.data.content);
const resources = chapter.data.resources ?? [];
const attachment = chapter.data.attachment;
const attachmentUrl = attachment?.url ?? attachment?.src ?? null;
---

<Base
	title={seo.title}
	pageTitle={seo.ogTitle}
	description={seo.description}
	canonical={seo.canonical}
	content={{ collection: "handbook", id: chapter.data.id, slug }}
>
	<article>
		<header class="border-b border-border bg-surface-75">
			<Container>
				<div class="grid gap-10 py-12 sm:py-16 lg:grid-cols-[1.1fr_0.9fr] lg:items-end">
					<div>
						<div class="flex flex-wrap items-center gap-2">
							<Badge variant="primary">{chapter.data.section}</Badge>
							<span class="font-mono text-[11px] uppercase tracking-wider text-foreground-lighter">
								Chapter {String(currentIndex + 1).padStart(2, "0")} ·{" "}
								{chapter.data.reading_time ?? 1} min
							</span>
						</div>
						<h1 class="display-section mt-4 text-balance" {...chapter.edit.title}>
							{chapter.data.title}
						</h1>
						{chapter.data.summary ? (
							<p class="mt-4 max-w-2xl text-lg leading-relaxed text-muted-foreground" {...chapter.edit.summary}>
								{chapter.data.summary}
							</p>
						) : null}
						<div class="mt-6 flex flex-wrap items-center gap-4">
							<Byline bylines={chapter.data.bylines} size="sm" />
							<span class="font-mono text-[11px] uppercase tracking-wider text-foreground-lighter">
								Updated {formatDate(chapter.data.updated ?? chapter.data.updatedAt)}
							</span>
						</div>
					</div>

					<div class="rounded-lg border border-border bg-background p-5">
						<p class="heading-meta text-foreground-lighter">In this chapter</p>
						<Toc headings={headings} label="Sections" class="mt-3" />
						{(chapter.data.audience ?? []).length > 0 ? (
							<div class="mt-5 border-t border-border pt-4">
								<p class="font-mono text-[10px] uppercase tracking-wider text-foreground-lighter">
									Written for
								</p>
								<div class="mt-2 flex flex-wrap gap-1.5">
									{(chapter.data.audience ?? []).map((audience) => (
										<Badge>{audience}</Badge>
									))}
								</div>
							</div>
						) : null}
					</div>
				</div>
			</Container>
		</header>

		<Section>
			<div class="grid gap-12 lg:grid-cols-[minmax(0,1fr)_16rem]">
				<div>
					<Prose value={chapter.data.content} />

					{
						resources.length > 0 ? (
							<div class="mt-12 border-t border-border pt-6">
								<p class="heading-meta text-foreground-lighter">Resources</p>
								<ul class="mt-4 grid gap-2 sm:grid-cols-2">
									{resources.map((resource) => (
										<li>
											{resource.url ? (
												<a
													href={resource.url}
													class="group flex items-start justify-between gap-3 rounded-md border border-border bg-surface-75 p-3 transition-colors hover:border-border-strong"
													target={resource.url.startsWith("http") ? "_blank" : undefined}
													rel={resource.url.startsWith("http") ? "noopener noreferrer" : undefined}
												>
													<span>
														<span class="block text-sm font-medium group-hover:underline">
															{resource.label}
														</span>
														{resource.kind ? (
															<span class="mt-0.5 block font-mono text-[10px] uppercase tracking-wider text-foreground-lighter">
																{resource.kind}
															</span>
														) : null}
													</span>
													<span class="font-mono text-[11px] text-foreground-lighter" aria-hidden="true">
														↗
													</span>
												</a>
											) : (
												<span class="block rounded-md border border-border bg-surface-75 p-3 text-sm">
													{resource.label}
												</span>
											)}
										</li>
									))}
								</ul>
							</div>
						) : null
					}

					{
						attachmentUrl ? (
							<div class="mt-8 rounded-md border border-border bg-surface-75 p-4">
								<p class="heading-meta text-foreground-lighter">Attachment</p>
								<a href={attachmentUrl} class="text-link mt-2 inline-block text-sm" download>
									{attachment?.filename ?? "Download the file"}
								</a>
							</div>
						) : null
					}

					<nav class="mt-12 grid gap-3 border-t border-border pt-6 sm:grid-cols-2" aria-label="Chapter navigation">
						{previous ? (
							<a
								href={`/handbook/${previous.id}`}
								class="group rounded-md border border-border bg-surface-75 p-4 transition-colors hover:border-border-strong"
							>
								<span class="font-mono text-[10px] uppercase tracking-wider text-foreground-lighter">
									Previous
								</span>
								<span class="mt-1 block text-sm font-medium group-hover:underline">
									{previous.data.title}
								</span>
							</a>
						) : (
							<span />
						)}
						{next ? (
							<a
								href={`/handbook/${next.id}`}
								class="group rounded-md border border-border bg-surface-75 p-4 text-right transition-colors hover:border-border-strong"
							>
								<span class="font-mono text-[10px] uppercase tracking-wider text-foreground-lighter">
									Next
								</span>
								<span class="mt-1 block text-sm font-medium group-hover:underline">
									{next.data.title}
								</span>
							</a>
						) : (
							<span />
						)}
					</nav>
				</div>

				<aside class="space-y-8 lg:sticky lg:top-20 lg:self-start">
					<div>
						<p class="heading-meta text-foreground-lighter">{chapter.data.section}</p>
						<ul class="mt-3 space-y-1">
							{siblings.length > 0 ? (
								siblings.map((entry) => (
									<li>
										<a href={`/handbook/${entry.id}`} class="toc-link">
											{entry.data.title}
										</a>
									</li>
								))
							) : (
								<li class="text-sm text-muted-foreground">No other chapters in this section.</li>
							)}
						</ul>
					</div>
					<div class="border-t border-border pt-5">
						<p class="heading-meta text-foreground-lighter">The whole handbook</p>
						<a href="/handbook" class="text-link mt-2 inline-block font-mono text-[11px] uppercase tracking-wider">
							All chapters
						</a>
					</div>
				</aside>
			</div>
		</Section>
	</article>
</Base>
