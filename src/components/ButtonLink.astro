---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"a"> {
	href: string;
	variant?: "primary" | "secondary" | "ghost";
	size?: "sm" | "md";
}

const {
	href,
	variant = "primary",
	size = "md",
	class: className,
	...attrs
} = Astro.props;

const variants = {
	primary:
		"border-transparent bg-primary-solid text-primary-solid-foreground hover:bg-primary-hover",
	secondary:
		"border-border-strong bg-surface-75 text-foreground hover:bg-surface-200",
	ghost: "border-transparent bg-transparent text-foreground hover:bg-surface-200",
};

const sizes = {
	sm: "px-3 py-1.5 text-xs",
	md: "px-4 py-2 text-sm",
};
---

<a
	href={href}
	class:list={[
		"inline-flex items-center justify-center gap-2 rounded-md border font-medium transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring",
		variants[variant],
		sizes[size],
		className,
	]}
	{...attrs}
>
	<slot />
</a>
