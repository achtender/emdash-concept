---
import { getEmDashCollection } from "emdash";
import Base from "../../layouts/Base.astro";
import PageHeader from "../../components/PageHeader.astro";
import Section from "../../components/Section.astro";
import Badge from "../../components/Badge.astro";
import EmptyState from "../../components/EmptyState.astro";
import { formatDate } from "../../utils/format";

const { entries: chapters, cacheHint } = await getEmDashCollection("handbook", {
	orderBy: { order: "asc" },
	limit: 100,
});
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const SECTION_ORDER = ["Foundations", "Craft", "Process", "Standards"];

const sections = SECTION_ORDER.map((section) => ({
	section,
	chapters: chapters.filter((chapter) => chapter.data.section === section),
})).filter((group) => group.chapters.length > 0);

const totalMinutes = chapters.reduce((total, chapter) => total + (chapter.data.reading_time ?? 0), 0);
---

<Base
	title="Handbook"
	description="The Fieldwork handbook: how the studio writes, edits, publishes, and keeps its tools honest."
	canonical={`${Astro.url.origin}/handbook`}
>
	<PageHeader
		eyebrow="Fieldwork / Handbook"
		title="How the studio works"
		description="The handbook is the internal counterpart to the journal. It holds the practices we want to repeat: the writing rules, the editorial states, and the checks that keep the work honest."
	>
		<div class="mt-6 flex flex-wrap items-center gap-3 font-mono text-[11px] uppercase tracking-wider text-foreground-lighter">
			<span>{chapters.length} chapters</span>
			<span aria-hidden="true">·</span>
			<span>{totalMinutes} minutes of reading</span>
			<span aria-hidden="true">·</span>
			<span>Updated as the practice changes</span>
		</div>
	</PageHeader>

	<Section>
		{
			sections.length > 0 ? (
				<div class="grid gap-12 lg:grid-cols-[13rem_minmax(0,1fr)]">
					<aside class="lg:sticky lg:top-20 lg:self-start">
						<p class="heading-meta text-foreground-lighter">Sections</p>
						<ul class="mt-3 space-y-1">
							{sections.map((group) => (
								<li>
									<a href={`#${group.section.toLowerCase()}`} class="toc-link">
										{group.section}
										<span class="ml-1 font-mono text-[10px] text-foreground-lighter">
											{group.chapters.length}
										</span>
									</a>
								</li>
							))}
						</ul>
					</aside>

					<div class="space-y-14">
						{sections.map((group, groupIndex) => (
							<section id={group.section.toLowerCase()} class="scroll-mt-20">
								<div class="flex items-baseline justify-between gap-4 border-b border-border pb-3">
									<div class="flex items-baseline gap-3">
										<span class="font-mono text-[11px] uppercase tracking-wider text-foreground-lighter">
											{String(groupIndex + 1).padStart(2, "0")}
										</span>
										<h2 class="heading-section">{group.section}</h2>
									</div>
									<span class="font-mono text-[11px] uppercase tracking-wider text-foreground-lighter">
										{group.chapters.length} {group.chapters.length === 1 ? "chapter" : "chapters"}
									</span>
								</div>

								<ol class="divide-y divide-border">
									{group.chapters.map((chapter, index) => (
										<li>
											<a
												href={`/handbook/${chapter.id}`}
												class="group grid gap-4 py-5 transition-colors sm:grid-cols-[auto_minmax(0,1fr)_auto] sm:items-start"
											>
												<span class="font-mono text-[11px] uppercase tracking-wider text-foreground-lighter">
													{String(index + 1).padStart(2, "0")}
												</span>
												<span class="min-w-0">
													<span class="block text-base font-medium tracking-tight group-hover:underline">
														{chapter.data.title}
													</span>
													{chapter.data.summary ? (
														<span class="mt-1 block max-w-xl text-sm leading-relaxed text-muted-foreground">
															{chapter.data.summary}
														</span>
													) : null}
													<span class="mt-2 flex flex-wrap items-center gap-2">
														{(chapter.data.audience ?? []).map((audience) => (
															<Badge>{audience}</Badge>
														))}
													</span>
												</span>
												<span class="font-mono text-[10px] uppercase tracking-wider text-foreground-lighter sm:text-right">
													<span class="block">{chapter.data.reading_time ?? 1} min</span>
													<span class="mt-1 block">
														Updated {formatDate(chapter.data.updated ?? chapter.data.updatedAt)}
													</span>
												</span>
											</a>
										</li>
									))}
								</ol>
							</section>
						))}
					</div>
				</div>
			) : (
				<EmptyState
					title="The handbook is being written"
					description="Add a handbook chapter in the admin and it will appear here."
				/>
			)
		}
	</Section>
</Base>
