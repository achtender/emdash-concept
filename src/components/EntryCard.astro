---
import type { MediaValue } from "emdash";
import Badge from "./Badge.astro";
import Cover from "./Cover.astro";

interface Props {
	href: string;
	title: string;
	description?: string | null;
	meta?: string | null;
	badge?: string | null;
	image?: MediaValue | null;
	seed?: string;
	cover?: boolean;
	class?: string;
}

const {
	href,
	title,
	description,
	meta,
	badge,
	image,
	seed,
	cover = true,
	class: className,
} = Astro.props;
---

<article
	class:list={[
		"group overflow-hidden rounded-lg border border-border bg-surface-75 transition-colors hover:border-border-strong",
		className,
	]}
>
	<a
		href={href}
		class="flex h-full flex-col rounded-lg focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
	>
		{
			cover ? (
				<Cover
					title={title}
					seed={seed ?? href}
					image={image}
					class="rounded-none border-0 border-b border-border"
				/>
			) : null
		}
		<div class="flex flex-1 flex-col p-5">
			<div class="flex flex-wrap items-center gap-2">
				{badge ? <Badge>{badge}</Badge> : null}
				{meta ? <span class="font-mono text-[11px] text-foreground-lighter">{meta}</span> : null}
			</div>
			<h3 class="mt-3 text-base font-medium tracking-tight text-foreground">{title}</h3>
			{
				description ? (
					<p class="mt-2 line-clamp-3 text-sm leading-relaxed text-muted-foreground">
						{description}
					</p>
				) : null
			}
			<span class="mt-auto pt-4 font-mono text-[11px] uppercase tracking-wider text-primary">
				Read
			</span>
		</div>
	</a>
</article>
