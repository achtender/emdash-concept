---
import { getTaxonomyTermsWithCacheHint } from "emdash";
import LiveSearch from "emdash/ui/search";
import Base from "../layouts/Base.astro";
import PageHeader from "../components/PageHeader.astro";
import Section from "../components/Section.astro";
import Badge from "../components/Badge.astro";
import { flattenTerms } from "../utils/terms";

const [categoryResult, tagResult] = await Promise.all([
	getTaxonomyTermsWithCacheHint("category", { includeCounts: true }),
	getTaxonomyTermsWithCacheHint("tag", { includeCounts: true }),
]);
if (Astro.cache?.enabled) {
	Astro.cache.set(categoryResult.cacheHint);
	Astro.cache.set(tagResult.cacheHint);
}

const categories = flattenTerms(categoryResult.data).filter((term) => (term.count ?? 0) > 0);
const tags = flattenTerms(tagResult.data).filter((term) => (term.count ?? 0) > 0);

const routeMap = {
	posts: "/journal/:slug",
	pages: "/:slug",
	events: "/events/:slug",
	handbook: "/handbook/:slug",
};
---

<Base
	title="Search"
	description="Search the Fieldwork journal, handbook, events, and pages."
	canonical={`${Astro.url.origin}/search`}
>
	<PageHeader
		eyebrow="Fieldwork / Search"
		title="Find the thread"
		description="Search across the journal, the handbook, the calendar, and every page. Results come from EmDash's full-text index, not a third-party service."
	/>

	<Section>
		<div class="mx-auto max-w-2xl">
			<div class="search-theme">
				<LiveSearch
					collections={["posts", "handbook", "events", "pages"]}
					routeMap={routeMap}
					searchPage="/search"
					placeholder="Search the archive…"
					autofocus
					limit={12}
					class="w-full"
					inputClass="search-input"
					resultsClass="search-results"
					resultClass="search-result"
				/>
			</div>

			<p class="mt-4 font-mono text-[11px] uppercase tracking-wider text-foreground-lighter">
				Try a title, a place, or a phrase from an entry. Press Enter to keep the full result list.
			</p>

			<div class="mt-12 grid gap-8 border-t border-border pt-8 sm:grid-cols-2">
				<div>
					<p class="heading-meta text-foreground-lighter">Browse categories</p>
					<ul class="mt-3 space-y-1">
						{categories.map((term) => (
							<li>
								<a
									href={`/category/${term.slug}`}
									class="flex items-baseline justify-between gap-3 py-1 text-sm text-muted-foreground transition-colors hover:text-foreground"
								>
									<span>{term.label}</span>
									<span class="font-mono text-[11px] text-foreground-lighter">{term.count}</span>
								</a>
							</li>
						))}
					</ul>
				</div>

				<div>
					<p class="heading-meta text-foreground-lighter">Browse tags</p>
					<ul class="mt-3 flex flex-wrap gap-1.5">
						{tags.map((term) => (
							<li>
								<a href={`/tag/${term.slug}`} class="inline-block">
									<Badge class="transition-colors hover:border-border-strong hover:text-foreground">
										{term.label}
									</Badge>
								</a>
							</li>
						))}
					</ul>
				</div>
			</div>

			<div class="mt-12 flex flex-wrap items-center justify-between gap-4 border-t border-border pt-6">
				<p class="max-w-md text-sm leading-relaxed text-muted-foreground">
					Looking for something specific? The journal archive is chronological, and the handbook
					is organised by practice.
				</p>
				<div class="flex gap-4">
					<a href="/journal" class="text-link font-mono text-[11px] uppercase tracking-wider">
						Journal
					</a>
					<a href="/handbook" class="text-link font-mono text-[11px] uppercase tracking-wider">
						Handbook
					</a>
				</div>
			</div>
		</div>
	</Section>
</Base>
