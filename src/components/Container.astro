---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"div"> {
	size?: "default" | "narrow" | "wide";
}

const { size = "default", class: className, ...attrs } = Astro.props;

const width = {
	default: "max-w-5xl",
	narrow: "max-w-2xl",
	wide: "max-w-6xl",
}[size];
---

<div class:list={["mx-auto w-full px-5 sm:px-8", width, className]} {...attrs}>
	<slot />
</div>
