---
import {
	getEmDashCollection,
	getEmDashEntry,
	getSeoMeta,
	getSiteSettings,
	decodeSlug,
} from "emdash";
import Base from "../../layouts/Base.astro";
import Container from "../../components/Container.astro";
import Section from "../../components/Section.astro";
import Cover from "../../components/Cover.astro";
import Badge from "../../components/Badge.astro";
import ButtonLink from "../../components/ButtonLink.astro";
import Byline from "../../components/Byline.astro";
import Prose from "../../components/Prose.astro";
import EventCard from "../../components/EventCard.astro";
import { formatDateRange, formatTime } from "../../utils/format";
import { resolveStarterSiteIdentity } from "../../utils/site-identity";

const slug = decodeSlug(Astro.params.slug);
if (!slug) return Astro.rewrite("/404");

const { entry: event, cacheHint } = await getEmDashEntry("events", slug);
if (!event) return Astro.rewrite("/404");
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const moreResult = await getEmDashCollection("events", {
	orderBy: { start: "asc" },
	limit: 100,
});
if (Astro.cache?.enabled) Astro.cache.set(moreResult.cacheHint);

const { siteTitle } = resolveStarterSiteIdentity(await getSiteSettings());
const seo = getSeoMeta(event, {
	siteTitle,
	siteUrl: Astro.url.origin,
	path: Astro.url.pathname.replace(/\/$/, ""),
});

const dateLabel = formatDateRange(event.data.start, event.data.end ?? event.data.start);
const timeLabel = event.data.all_day
	? "All day"
	: [formatTime(event.data.start_time), formatTime(event.data.end_time)].filter(Boolean).join("–");
const takeaways = Array.isArray(event.data.takeaways) ? (event.data.takeaways as string[]) : [];
const audience = event.data.audience ?? [];
const more = moreResult.entries.filter((entry) => entry.id !== event.id).slice(0, 3);

const details = [
	{ label: "Date", value: dateLabel },
	{ label: "Time", value: timeLabel },
	{ label: "Format", value: event.data.format ?? null },
	{ label: "Location", value: event.data.location ?? null },
	{ label: "Capacity", value: event.data.capacity ? `${event.data.capacity} places` : null },
].filter((detail) => detail.value);
---

<Base
	title={seo.title}
	pageTitle={seo.ogTitle}
	description={seo.description}
	canonical={seo.canonical}
	image={seo.ogImage}
	content={{ collection: "events", id: event.data.id, slug }}
>
	<article>
		<header class="border-b border-border bg-surface-75">
			<Container>
				<div class="grid gap-10 py-12 sm:py-16 lg:grid-cols-[1.1fr_0.9fr] lg:items-end">
					<div>
						<div class="flex flex-wrap items-center gap-2">
							<Badge variant="primary">{event.data.format ?? "Event"}</Badge>
							<span class="font-mono text-[11px] uppercase tracking-wider text-foreground-lighter">
								{dateLabel} · {timeLabel}
							</span>
						</div>
						<h1 class="display-section mt-4 text-balance" {...event.edit.title}>{event.data.title}</h1>
						{event.data.summary ? (
							<p class="mt-4 max-w-2xl text-lg leading-relaxed text-muted-foreground" {...event.edit.summary}>
								{event.data.summary}
							</p>
						) : null}
						<div class="mt-6 flex flex-wrap items-center gap-3">
							{event.data.registration_url ? (
								<ButtonLink href={event.data.registration_url} target="_blank" rel="noopener noreferrer">
									Register
								</ButtonLink>
							) : null}
							<ButtonLink href={`/events/${event.id}.ics`} variant="secondary">
								Add to calendar
							</ButtonLink>
						</div>
						<Byline bylines={event.data.bylines} size="md" class="mt-8" />
					</div>

					<Cover
						title={event.data.title}
						seed={event.id}
						image={event.data.cover}
						ratio="wide"
						priority
					/>
				</div>
			</Container>
		</header>

		<Section>
			<div class="grid gap-12 lg:grid-cols-[minmax(0,1fr)_18rem]">
				<div>
					<Prose value={event.data.content} />

					{takeaways.length > 0 ? (
						<div class="mt-10 rounded-lg border border-border bg-surface-75 p-6">
							<p class="heading-meta text-foreground-lighter">What you leave with</p>
							<ul class="mt-4 space-y-2">
								{takeaways.map((item) => (
									<li class="flex gap-3 text-sm leading-relaxed text-muted-foreground">
										<span class="mt-2 size-1.5 shrink-0 rounded-full bg-primary" aria-hidden="true" />
										<span>{item}</span>
									</li>
								))}
							</ul>
						</div>
					) : null}
				</div>

				<aside class="space-y-6 lg:sticky lg:top-20 lg:self-start">
					<div class="rounded-lg border border-border bg-surface-75 p-5">
						<p class="heading-meta text-foreground-lighter">The details</p>
						<dl class="mt-4 space-y-3">
							{details.map((detail) => (
								<div>
									<dt class="font-mono text-[10px] uppercase tracking-wider text-foreground-lighter">
										{detail.label}
									</dt>
									<dd class="mt-0.5 text-sm">{detail.value}</dd>
								</div>
							))}
						</dl>
						{audience.length > 0 ? (
							<div class="mt-5 border-t border-border pt-4">
								<p class="font-mono text-[10px] uppercase tracking-wider text-foreground-lighter">
									Who it's for
								</p>
								<div class="mt-2 flex flex-wrap gap-1.5">
									{audience.map((group) => (
										<Badge>{group}</Badge>
									))}
								</div>
							</div>
						) : null}
						<div class="mt-5 border-t border-border pt-4">
							<a
								href={`/events/${event.id}.ics`}
								class="text-link font-mono text-[11px] uppercase tracking-wider"
							>
								Download .ics
							</a>
						</div>
					</div>

					<div class="rounded-lg border border-border bg-surface-75 p-5">
						<p class="heading-meta text-foreground-lighter">The host</p>
						<div class="mt-3">
							<Byline bylines={event.data.bylines} showRole={false} />
						</div>
					</div>
				</aside>
			</div>
		</Section>

		{
			more.length > 0 ? (
				<Section class="border-t border-border bg-surface-75">
					<div class="flex flex-wrap items-end justify-between gap-4">
						<div>
							<p class="heading-meta text-foreground-lighter">Also on the calendar</p>
							<h2 class="heading-section mt-2">More events</h2>
						</div>
						<a href="/calendar" class="text-link font-mono text-xs uppercase tracking-wider">
							Month view
						</a>
					</div>
					<div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
						{more.map((entry) => (
							<EventCard
								href={`/events/${entry.id}`}
								title={entry.data.title}
								summary={entry.data.summary}
								start={entry.data.start}
								end={entry.data.end}
								startTime={entry.data.start_time}
								endTime={entry.data.end_time}
								allDay={entry.data.all_day}
								location={entry.data.location}
								format={entry.data.format}
								image={entry.data.cover}
								seed={entry.id}
							/>
						))}
					</div>
				</Section>
			) : null
		}
	</article>
</Base>
