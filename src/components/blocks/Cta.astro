---
import ButtonLink from "../ButtonLink.astro";
import Container from "../Container.astro";

interface Props {
	value: {
		heading: string;
		body?: string;
		action_label?: string;
		action_href?: string;
	};
}

const { value } = Astro.props;
---

<section class="border-t border-border bg-surface-100">
	<Container>
		<div class="flex flex-col items-start justify-between gap-6 py-14 sm:flex-row sm:items-center">
			<div>
				<h2 class="heading-section max-w-xl text-balance">{value.heading}</h2>
				{value.body ? (
					<p class="mt-3 max-w-xl text-sm leading-relaxed text-muted-foreground">{value.body}</p>
				) : null}
			</div>
			{
				value.action_label && value.action_href ? (
					<ButtonLink href={value.action_href}>{value.action_label}</ButtonLink>
				) : null
			}
		</div>
	</Container>
</section>
