---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"span"> {
	variant?: "default" | "primary" | "solid" | "outline";
}

const { variant = "default", class: className, ...attrs } = Astro.props;

const variants = {
	default: "border-border bg-surface-100 text-muted-foreground",
	primary: "border-primary/30 bg-primary/10 text-primary",
	solid: "border-transparent bg-primary-solid text-primary-solid-foreground",
	outline: "border-border-strong bg-transparent text-foreground",
};
---

<span
	class:list={[
		"inline-flex items-center rounded-sm border px-1.5 py-0.5 font-mono text-[11px] uppercase tracking-wider",
		variants[variant],
		className,
	]}
	{...attrs}
>
	<slot />
</span>
