---
import { getEmDashEntry, getSeoMeta, getSiteSettings } from "emdash";
import { Form } from "@emdash-cms/plugin-forms/ui";
import Base from "../layouts/Base.astro";
import PageHeader from "../components/PageHeader.astro";
import Section from "../components/Section.astro";
import Prose from "../components/Prose.astro";
import { resolveStarterSiteIdentity } from "../utils/site-identity";

// The contact page is an explicit route rather than the catch-all `[slug]`
// page so it can embed the forms plugin directly.
const { entry: page, cacheHint } = await getEmDashEntry("pages", "contact");
if (Astro.cache?.enabled && cacheHint) Astro.cache.set(cacheHint);

const { siteTitle } = resolveStarterSiteIdentity(await getSiteSettings());

const title = page?.data.title ?? "Contact";
const description =
	page?.data.excerpt ??
	"Write to the studio about editorial work, design systems, or a project that needs a second reader.";

const seo = page
	? getSeoMeta(page, {
			siteTitle,
			siteUrl: Astro.url.origin,
			path: "/contact",
		})
	: {
			title: `${title} — ${siteTitle}`,
			ogTitle: title,
			description,
			canonical: `${Astro.url.origin}/contact`,
			ogImage: undefined,
		};
---

<Base
	title={seo.title}
	pageTitle={seo.ogTitle}
	description={seo.description}
	canonical={seo.canonical}
	image={seo.ogImage}
	content={page ? { collection: "pages", id: page.data.id, slug: "contact" } : undefined}
>
	<PageHeader eyebrow="Fieldwork / Contact" title={title} description={description} />

	<Section>
		<div class="grid gap-12 lg:grid-cols-[minmax(0,1fr)_24rem]">
			<div class="min-w-0">
				{page ? (
					<Prose value={page.data.content} />
				) : (
					<div class="prose">
						<p>
							We read everything that arrives, but we answer slowly. A useful note tells us what
							you are making, who it is for, and what kind of help you need.
						</p>
					</div>
				)}

				<div class="mt-12 grid gap-4 border-t border-border pt-8 sm:grid-cols-3">
					<div>
						<p class="heading-meta text-foreground-lighter">Response time</p>
						<p class="mt-2 text-sm leading-relaxed text-muted-foreground">
							Most replies go out within a week. We answer every note that includes a real
							question.
						</p>
					</div>
					<div>
						<p class="heading-meta text-foreground-lighter">What to send</p>
						<p class="mt-2 text-sm leading-relaxed text-muted-foreground">
							The shape of the project, the audience, and the deadline you are working against.
						</p>
					</div>
					<div>
						<p class="heading-meta text-foreground-lighter">Elsewhere</p>
						<ul class="mt-2 space-y-1 text-sm">
							<li>
								<a href="/authors" class="text-link">The people</a>
							</li>
							<li>
								<a href="/handbook" class="text-link">How we work</a>
							</li>
							<li>
								<a href="/calendar" class="text-link">Studio events</a>
							</li>
						</ul>
					</div>
				</div>
			</div>

			<aside class="lg:sticky lg:top-20 lg:self-start">
				<div class="rounded-lg border border-border bg-surface-75 p-6">
					<p class="heading-meta text-foreground-lighter">Start a conversation</p>
					<h2 class="heading-section mt-2">Tell us what you are making</h2>
					<p class="mt-2 text-sm leading-relaxed text-muted-foreground">
						This form is built and stored by the EmDash forms plugin. Submissions appear in the
						admin, not in an inbox.
					</p>
					<div class="ec-form-theme mt-6">
						<Form id="contact" />
					</div>
				</div>
				<p class="mt-4 font-mono text-[10px] uppercase leading-relaxed tracking-wider text-foreground-lighter">
					Prefer email? Write to{" "}
					<a href="mailto:studio@fieldwork.example" class="text-link normal-case tracking-normal">
						studio@fieldwork.example
					</a>
				</p>
			</aside>
		</div>
	</Section>
</Base>
